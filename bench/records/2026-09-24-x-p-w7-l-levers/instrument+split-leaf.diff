+export type RegexAlternative = Readonly<{ source: string; first: CharSet; nullable: boolean }>;
+
+/**
+ * A regex whose top level is an ordered disjunction `A|B|…`: each alternative's own source, FIRST set
+ * and nullability (flags respected). `null` when the top level is one alternative, or when splitting
+ * could change an answer or its groups: a capturing or named group, a back-reference, or the `v` flag
+ * (nested classes). With nothing after the disjunction, a sticky match at `p` answers the first
+ * alternative that matches there, so an alternative that cannot start with the unit at `p` (not in
+ * its FIRST set, not nullable) can be dropped at `p` without changing the match.
