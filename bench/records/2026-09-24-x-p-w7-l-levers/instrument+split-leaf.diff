+        const ch = src[i];
+        if (ch === "\\") {
+            const next = src[i + 1] ?? "";
+            if (/[1-9k]/.test(next)) return null; // back-reference
+            i++;
+        } else if (ch === "[") {
+            for (i++; i < src.length && src[i] !== "]"; i++) if (src[i] === "\\") i++;
+        } else if (ch === "(") {
+            const lookbehind = src.startsWith("?<=", i + 1) || src.startsWith("?<!", i + 1);
