+    const flags = re.flags.replace(/[gy]/g, "");
+    return [-1, ...cuts].map((c, j) => {
+        const source = src.slice(c + 1, j < cuts.length ? cuts[j] : src.length);
+        const { first: f, nullable: n } = regexFirst(new RegExp(source, flags));
+        return { source, first: f, nullable: n };
+    });
