{"openapi":"3.1.0","info":{"title":"Fourier Analysis API","version":"0.2.0"},"paths":{"/api/images":{"post":{"tags":["images"],"summary":"Upload Image","operationId":"upload_image_api_images_post","requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/Body_upload_image_api_images_post"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImageAssetResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/images/by-hash/{sha256}":{"get":{"tags":["images"],"summary":"Get Image By Hash","operationId":"get_image_by_hash_api_images_by_hash__sha256__get","parameters":[{"name":"sha256","in":"path","required":true,"schema":{"type":"string","title":"Sha256"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImageAssetResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/images/{imageSlug}":{"get":{"tags":["images"],"summary":"Get Image Metadata","operationId":"get_image_metadata_api_images__imageSlug__get","parameters":[{"name":"imageSlug","in":"path","required":true,"schema":{"type":"string","title":"Imageslug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ImageAssetResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/images/{imageSlug}/blob":{"get":{"tags":["images"],"summary":"Get Image Blob","operationId":"get_image_blob_api_images__imageSlug__blob_get","parameters":[{"name":"imageSlug","in":"path","required":true,"schema":{"type":"string","title":"Imageslug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/images/{imageSlug}/thumbnail":{"get":{"tags":["images"],"summary":"Get Image Thumbnail","operationId":"get_image_thumbnail_api_images__imageSlug__thumbnail_get","parameters":[{"name":"imageSlug","in":"path","required":true,"schema":{"type":"string","title":"Imageslug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/images/{imageSlug}/overlay":{"get":{"tags":["images"],"summary":"Get Image Overlay","description":"Serve the image resized to match contour extraction dimensions.\n\nThe returned image is in the same pixel space that contour coordinates\nwere extracted from, enabling pixel-perfect overlay alignment.","operationId":"get_image_overlay_api_images__imageSlug__overlay_get","parameters":[{"name":"imageSlug","in":"path","required":true,"schema":{"type":"string","title":"Imageslug"}},{"name":"resize","in":"query","required":false,"schema":{"type":"integer","default":1024,"title":"Resize"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/images/{imageSlug}/extract-contour":{"post":{"tags":["images"],"summary":"Extract Contour","operationId":"extract_contour_api_images__imageSlug__extract_contour_post","parameters":[{"name":"imageSlug","in":"path","required":true,"schema":{"type":"string","title":"Imageslug"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExtractContourRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"title":"Response Extract Contour Api Images  Imageslug  Extract Contour Post"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/contours":{"post":{"tags":["contours"],"summary":"Save Contour","operationId":"save_contour_api_contours_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SaveContourRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/contours/{contourHash}":{"get":{"tags":["contours"],"summary":"Get Contour Endpoint","operationId":"get_contour_endpoint_api_contours__contourHash__get","parameters":[{"name":"contourHash","in":"path","required":true,"schema":{"type":"string","title":"Contourhash"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/contours/{contourHash}/compute/epicycles":{"post":{"tags":["contours"],"summary":"Compute Epicycles","operationId":"compute_epicycles_api_contours__contourHash__compute_epicycles_post","parameters":[{"name":"contourHash","in":"path","required":true,"schema":{"type":"string","title":"Contourhash"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeEpicyclesRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeResult"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/contours/{contourHash}/compute/bases":{"post":{"tags":["contours"],"summary":"Compute Bases","operationId":"compute_bases_api_contours__contourHash__compute_bases_post","parameters":[{"name":"contourHash","in":"path","required":true,"schema":{"type":"string","title":"Contourhash"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeBasesRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeResult"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/equations/compute":{"post":{"tags":["equations"],"summary":"Compute Equation","description":"Compute closed-form Fourier series for a user-supplied f(x).\n\nTries three tiers:\n  1. Symbolic integration (exact)\n  2. Sequence identification (conjectured)\n  3. Spline approximation (approximate)\n\nThe job runs in a worker process (``equation_series`` says why).","operationId":"compute_equation_api_equations_compute_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeEquationRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComputeEquationResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/equations/simplify":{"post":{"tags":["equations"],"summary":"Simplify Coefficients","description":"Simplify existing DFT coefficients for display overlay.\n\nX.F.W14V `.u2` — UIA-F-201: the answer carries the Σ form too, bounded at\nthe displayed N (``auto_harmonics``), so a notation, budget or Auto change\nre-renders both forms without a recompute.","operationId":"simplify_coefficients_api_equations_simplify_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SimplifyRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SimplifyResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/sessions":{"post":{"tags":["sessions"],"summary":"Register","description":"Create a new anonymous user and session.","operationId":"register_api_sessions_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"delete":{"tags":["sessions"],"summary":"Logout","description":"Delete the current session.","operationId":"logout_api_sessions_delete","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/sessions/login":{"post":{"tags":["sessions"],"summary":"Login","description":"Login by slug — creates a new session for an existing user.","operationId":"login_api_sessions_login_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/sessions/me":{"get":{"tags":["sessions"],"summary":"Me","description":"Return current user info.","operationId":"me_api_sessions_me_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/visualizations":{"post":{"tags":["visualizations"],"summary":"Create Visualization","description":"Publish a new visualization. Anonymous publish is forbidden (§3 → 401).","operationId":"create_visualization_api_visualizations_post","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VisualizationCreate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"get":{"tags":["visualizations"],"summary":"List Visualizations","description":"List visualizations with cursor pagination (CRUD-CONTRACT §0 SOTA-1, §4).\n\nAnonymous / default: only ``visibility=public`` live rows. ``?owner=me``\n(with a session) returns the caller's rows in all three visibility states.\n\nNarrowing (UIA-F-39), each optional and ANDed: ``q`` — a case-insensitive\nsubstring of the title, description or a tag; ``tier`` — ``featured`` /\n``saved`` / ``normal`` (a row never tiered is ``normal``) or ``all``;\n``basis`` — a member of ``active_bases``.","operationId":"list_visualizations_api_visualizations_get","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"default":20,"title":"Limit"}},{"name":"sort","in":"query","required":false,"schema":{"type":"string","default":"newest","title":"Sort"}},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","default":"","title":"Cursor"}},{"name":"owner","in":"query","required":false,"schema":{"type":"string","default":"","title":"Owner"}},{"name":"q","in":"query","required":false,"schema":{"type":"string","maxLength":200,"default":"","title":"Q"}},{"name":"tier","in":"query","required":false,"schema":{"type":"string","default":"all","title":"Tier"}},{"name":"basis","in":"query","required":false,"schema":{"type":"string","maxLength":64,"default":"","title":"Basis"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}":{"get":{"tags":["visualizations"],"summary":"Get Visualization","description":"Read a single visualization by slug.\n\n``draft`` rows are visible to the owner only (non-owners get 404, not 403 —\nrefuses to confirm existence, §4). Soft-deleted rows read 404 to anonymous\ncallers and to non-owners.","operationId":"get_visualization_api_visualizations__slug__get","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"patch":{"tags":["visualizations"],"summary":"Update Visualization","description":"Owner-bound partial update guarded by an ``If-Match`` ETag (§3, §0 SOTA-2).","operationId":"update_visualization_api_visualizations__slug__patch","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VisualizationUpdate"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["visualizations"],"summary":"Delete Visualization","description":"Owner-bound soft-delete guarded by an ``If-Match`` ETag (§5).","operationId":"delete_visualization_api_visualizations__slug__delete","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}/restore":{"post":{"tags":["visualizations"],"summary":"Restore Visualization","description":"Restore a soft-deleted visualization within the grace window (§5).","operationId":"restore_visualization_api_visualizations__slug__restore_post","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}/remix":{"post":{"tags":["visualizations"],"summary":"Remix Visualization","description":"Fork a source visualization into a NEW child carrying a recorded atom-diff.\n\nThe remix is the ordered, idempotent, content-addressed write sequence of\n``J.W1-crud-remix §11`` (NO Mongo transaction — standalone-topology-honest):\ndelete-race guard → insert child viz (slug-unique) → insert child root\nversion (content-addressed) → conditional-last ``fork_count`` bump. A no-op\nremix (no atom changed) is a 422 ``urn:contract:remix-noop`` (the fourier\ntightening over value.js's verbatim-copy fork).","operationId":"remix_visualization_api_visualizations__slug__remix_post","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VisualizationRemix"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}/publish":{"post":{"tags":["visualizations"],"summary":"Publish Visualization","description":"Flip a private/unlisted row to ``public`` in place (idempotent, no new row).","operationId":"publish_visualization_api_visualizations__slug__publish_post","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}/unpublish":{"post":{"tags":["visualizations"],"summary":"Unpublish Visualization","description":"Flip a ``public`` row out of the public view to ``unlisted`` (contract-legal).","operationId":"unpublish_visualization_api_visualizations__slug__unpublish_post","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}/like":{"get":{"tags":["visualizations"],"summary":"Get Like","description":"The caller's like state and the row's like count.","operationId":"get_like_api_visualizations__slug__like_get","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"put":{"tags":["visualizations"],"summary":"Set Like","description":"Set the caller's like state (idempotent per session); returns ``{liked, likes}``.","operationId":"set_like_api_visualizations__slug__like_put","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VisualizationLike"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}/forks":{"get":{"tags":["visualizations"],"summary":"List Forks","description":"List the public children that were remixed from ``slug`` (cursor-paginated).","operationId":"list_forks_api_visualizations__slug__forks_get","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"default":20,"title":"Limit"}},{"name":"sort","in":"query","required":false,"schema":{"type":"string","default":"newest","title":"Sort"}},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","default":"","title":"Cursor"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}/provenance":{"get":{"tags":["visualizations"],"summary":"Get Provenance","description":"The within-viz version ``chain`` PLUS the cross-viz ``fork_breadcrumb``\n(\"remixed from → … → original\") — the two distinct walks named in F-03.\nBoth ≤50, cycle-guarded; the chain is immutable, so the result is ETag-able.","operationId":"get_provenance_api_visualizations__slug__provenance_get","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}/diff":{"get":{"tags":["visualizations"],"summary":"Get Diff","description":"The canonical ``/diff`` envelope (``J-diff-shape.md §3.2``) between an\non-chain ``from`` set-hash and the viz HEAD. Default (no ``from``) returns the\nrecorded remix delta (``fork_of_hash`` → HEAD) — or ``identical`` for an\noriginal. Off-chain hash → 404; immutable, ETag-able (``\"<from>:<to>\"``).","operationId":"get_diff_api_visualizations__slug__diff_get","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}},{"name":"from","in":"query","required":false,"schema":{"type":"string","default":"","title":"From"}},{"name":"to","in":"query","required":false,"schema":{"type":"string","default":"","title":"To"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/visualizations/{slug}/versions":{"get":{"tags":["visualizations"],"summary":"List Versions","description":"The viz's own version chain, ``depth``-ordered, bounded ≤50 (no cursor —\nF-11: a string ``set_hash`` ``_id`` breaks ``ObjectId`` cursor casting).","operationId":"list_versions_api_visualizations__slug__versions_get","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/gallery/cursor":{"get":{"tags":["gallery"],"summary":"List Public Gallery","description":"Public gallery list — a ``visibility=\"public\"`` alias over ``visualizations``.\n\nRead-only, anonymous-permissible, cursor-paginated (CRUD-CONTRACT §0 SOTA-1,\n§4). The canonical path is ``GET /api/visualizations``; this alias is kept so\nthe pre-migration frontend keeps loading until B.W4 re-points it.","operationId":"list_public_gallery_api_gallery_cursor_get","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"default":20,"title":"Limit"}},{"name":"sort","in":"query","required":false,"schema":{"type":"string","default":"newest","title":"Sort"}},{"name":"cursor","in":"query","required":false,"schema":{"type":"string","default":"","title":"Cursor"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/admin/verify":{"get":{"tags":["admin"],"summary":"Admin Verify","description":"Verify admin token is valid.","operationId":"admin_verify_api_admin_verify_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/admin/stats":{"get":{"tags":["admin"],"summary":"Admin Stats","description":"Aggregate visualization and storage statistics (over the converged entity).","operationId":"admin_stats_api_admin_stats_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AdminStatsResponse"}}}}}}},"/api/admin/visualizations/{slug}/tier":{"put":{"tags":["admin"],"summary":"Set Tier","description":"Set the admin-curation tier for a visualization (CRUD-CONTRACT §7 ``feature``).\n\nGuarded by an ``If-Match`` ETag (§0 SOTA-2): a stale precondition is a 412\n``urn:contract:etag-mismatch``. Idempotent — re-setting the same tier is a 200.","operationId":"set_tier_api_admin_visualizations__slug__tier_put","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SetTierRequest"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/admin/visualizations/{slug}":{"delete":{"tags":["admin"],"summary":"Delete Visualization","description":"Moderate-delete a visualization (CRUD-CONTRACT §5 / §7).\n\nDefault is a soft-delete (``deleted_at`` write, restorable within grace).\n``?hard=true`` is the admin grace-bypass for illegal content (§7) — a true\nhard-delete in one operation. Both write an ``admin_audit`` row.","operationId":"delete_visualization_api_admin_visualizations__slug__delete","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string","title":"Slug"}},{"name":"hard","in":"query","required":false,"schema":{"type":"boolean","default":false,"title":"Hard"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/admin/users":{"get":{"tags":["admin"],"summary":"List Users","description":"Paginated user list with search and entry counts (over ``visualizations``).","operationId":"list_users_api_admin_users_get","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer","minimum":1,"default":1,"title":"Page"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"default":20,"title":"Limit"}},{"name":"sort","in":"query","required":false,"schema":{"type":"string","default":"newest","title":"Sort"}},{"name":"q","in":"query","required":false,"schema":{"type":"string","default":"","title":"Q"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/admin/users/{slug}/status":{"post":{"tags":["admin"],"summary":"Set User Status","description":"Set user status to active or suspended (CRUD-CONTRACT §7 suspend/unsuspend).","operationId":"set_user_status_api_admin_users__slug__status_post","parameters":[{"name":"slug","in":"path","required":true,"sche