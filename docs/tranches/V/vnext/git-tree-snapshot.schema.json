{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://babb.dev/schemas/vnext-git-tree-snapshot-1.json","title":"Canonical Git working-tree snapshot for deletion truth","type":"object","additionalProperties":false,"required":["schema","phase","captured_at","tool_sha256","repository","files","files_sha256","snapshot_hash"],"properties":{"schema":{"const":"vnext-git-tree-snapshot/1"},"phase":{"enum":["before","after"]},"captured_at":{"type":"string","format":"date-time"},"tool_sha256":{"$ref":"#/$defs/sha256"},"repository":{"type":"object","additionalProperties":false,"required":["path","canonical_realpath","branch","head","status_sha256","status_clean"],"properties":{"path":{"$ref":"#/$defs/absolutePath"},"canonical_realpath":{"$ref":"#/$defs/absolutePath"},"branch":{"$ref":"#/$defs/nonEmpty"},"head":{"$ref":"#/$defs/gitHead"},"status_sha256":{"$ref":"#/$defs/sha256"},"status_clean":{"const":true}}},"files":{"type":"array","items":{"$ref":"#/$defs/file"}},"files_sha256":{"$ref":"#/$defs/sha256"},"snapshot_hash":{"$ref":"#/$defs/sha256"}},"$defs":{"nonEmpty":{"type":"string","minLength":1},"absolutePath":{"type":"string","pattern":"^/","minLength":2},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"gitHead":{"type":"string","pattern":"^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},"relativePath":{"type":"string","minLength":1,"pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\).+$"},"file":{"type":"object","additionalProperties":false,"required":["path","mode","bytes","sha256"],"properties":{"path":{"$ref":"#/$defs/relativePath"},"mode":{"enum":["100644","100755","160000"]},"bytes":{"type":"integer","minimum":0},"sha256":{"$ref":"#/$defs/sha256"}}}}}