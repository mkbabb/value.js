wLoupeAt(rx: number, ry: number) {\n        loupeVisible.value = true;\n        loupeRelX.value = rx;\n        loupeRelY.value = ry;\n        drawLoupe(rx, ry);\n    }\n\n    function hideLoupe() {\n        loupeVisible.value = false;\n    }\n\n    return {\n        loupeCanvasRef,\n        loupeVisible,\n        loupeRelX,\n        loupeRelY,\n        drawLoupe,\n        showLoupeAt,\n        hideLoupe,\n    };\n}\n"
