function report(\n        paletteSlug: string,\n        reason: string,\n        detail?: string,\n    ): Promise<{ flagged: boolean } | undefined> {\n        try {\n            return await flagPalette(paletteSlug, reason, detail);\n        } catch (e) {\n            console.warn(\"Failed to flag palette:\", e);\n            return undefined;\n        }\n    }\n\n    return {\n        items,\n        total,\n        page,\n        pageSize,\n        loading,\n        loadError,\n        pageCount,\n        hasNext,\n        hasPrev,\n        loadFlagged,\n        dismiss,\n        deletePalette,\n        nextPage,\n        prevPage,\n        report,\n    };\n}\n"
