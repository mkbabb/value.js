on --watch\",\n        \"gh-pages\": \"vite build --mode gh-pages\",\n        \"prepare\": \"rm -rf dist && npm run build\",\n        \"pretypecheck\": \"npm run build\",\n        \"typecheck\": \"vue-tsc -p tsconfig.lib.json --noEmit && vue-tsc -p tsconfig.demo.json --noEmit\",\n        \"lint\": \"eslint . --max-warnings=0\",\n        \"test\": \"vitest run\",\n        \"test:e2e\": \"playwright test\"\n    },\n    \"repository\": {\n        \"type\": \"git\",\n        \"url\": \"git+https://github.com/mkbabb/value.js.git\"\n    },\n    \"author\": \"\",\n    \"engines\": {\n        \"node\": \">=22\"\n    },\n    \"bugs\": {\n        \"url\": \"https://github.com/mkbabb/value.js/issues\"\n    },\n    \"homepage\": \"https://github.com/mkbabb/value.js#readme\",\n    \"dependencies\": {\n        \"@mkbabb/glass-ui\": \"^7.0.0\",\n        \"@mkbabb/keyframes.js\": \"^6.0.0\"\n    },\n    \"devDependencies\": {\n        \"@lucide/vue\": \"^1.16.0\",\n        \"@playwright/test\": \"^1.60.0\",\n        \"@tailwindcss/postcss\": \"^4.3.0\",\n        \"@types/katex\": \"^0.16.8\",\n        \"@types/node\": \"^24.12.3\",\n        \"@types/sortablejs\": \"^1.15.9\",\n        \"@typescript-eslint/eslint-plugin\": \"^8.59.4\",\n        \"@typescript-eslint/parser\": \"^8.59.4\",\n        \"@vitejs/plugin-vue\": \"^6.0.7\",\n        \"@vue/test-utils\": \"^2.4.10\",\n        \"@vueuse/core\": \"^14.3.0\",\n        \"@vueuse/integrations\": \"^14.3.0\",\n        \"clsx\": \"^2.1.1\",\n        \"eslint\": \"^10.4.0\",\n        \"eslint-plugin-vue\": \"^10.9.1\",\n        \"highlight.js\": \"^11.11.1\",\n        \"jsdom\": \"^26.1.0\",\n        \"katex\": \"^0.16.47\",\n        \"prettier\": \"^3.8.3\",\n        \"reka-ui\": \"^2.9\",\n        \"sortablejs\": \"^1.15.7\",\n        \"tailwind-merge\": \"^3.6.0\",\n        \"tailwindcss\": \"^4.3.0\",\n        \"tw-animate-css\": \"^1.4.0\",\n        \"typescript\": \"^6.0.3\",\n        \"unplugin-vue-markdown\": \"^32.0.0\",\n        \"vite\": \"^8.0.13\",\n        \"vite-plugin-dts\": \"^4.5.4\",\n        \"vitest\": \"^3.2.4\",\n        \"vue\": \"^3.5.34\",\n        \"vue-eslint-parser\": \"^10.4.0\",\n        \"vue-router\": \"^5.1.0\",\n        \"vue-tsc\": \"^3.3.1\"\n    }\n}\n"
