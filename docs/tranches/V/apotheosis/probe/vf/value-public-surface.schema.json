{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/vnext-value-public-surface-2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "wave_id",
    "target_paths",
    "package",
    "exports",
    "tombstone_owner_return",
    "tombstones",
    "semantic_evidence",
    "manifest_hash"
  ],
  "properties": {
    "schema": { "const": "vnext-value-public-surface/2" },
    "wave_id": { "const": "V29T" },
    "target_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "manifest_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "tarball", "archive"],
      "properties": {
        "name": { "const": "@mkbabb/value.js" },
        "version": { "const": "5.0.0" },
        "tarball": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "sha512", "integrity"],
          "properties": {
            "path": { "$ref": "#/$defs/absolutePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "sha512": { "$ref": "#/$defs/sha512" },
            "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" }
          }
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_json_sha256", "files", "files_sha256"],
          "properties": {
            "package_json_sha256": { "$ref": "#/$defs/sha256" },
            "files": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/archiveFile" }
            },
            "files_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "exports": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "specifier", "symbol", "surface", "source", "declaration", "tarball_sha512", "semantic_assertion_id", "semantic_sha256"],
            "properties": {
              "id": { "$ref": "#/$defs/exportId" },
              "specifier": { "$ref": "#/$defs/survivingSpecifier" },
              "symbol": { "$ref": "#/$defs/symbol" },
              "surface": { "const": "type" },
              "source": { "$ref": "#/$defs/sourcePath" },
              "declaration": { "$ref": "#/$defs/declarationBinding" },
              "tarball_sha512": { "$ref": "#/$defs/sha512" },
              "semantic_assertion_id": { "$ref": "#/$defs/nonEmpty" },
              "semantic_sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "specifier", "symbol", "surface", "source", "declaration", "runtime", "tarball_sha512", "semantic_assertion_id", "semantic_sha256"],
            "properties": {
              "id": { "$ref": "#/$defs/exportId" },
              "specifier": { "$ref": "#/$defs/survivingSpecifier" },
              "symbol": { "$ref": "#/$defs/symbol" },
              "surface": { "const": "runtime" },
              "source": { "$ref": "#/$defs/sourcePath" },
              "declaration": { "$ref": "#/$defs/declarationBinding" },
              "runtime": { "$ref": "#/$defs/runtimeBinding" },
              "tarball_sha512": { "$ref": "#/$defs/sha512" },
              "semantic_assertion_id": { "$ref": "#/$defs/nonEmpty" },
              "semantic_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        ]
      }
    },
    "tombstone_owner_return": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "return_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "return_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "tombstones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["specifier", "disposition", "owner_wave_id", "owner_return_hash", "rationale", "decision_sha256"],
        "properties": {
          "specifier": { "enum": [".", "./quantize", "./value"] },
          "disposition": { "const": "tombstone" },
          "owner_wave_id": { "const": "V00C" },
          "owner_return_hash": { "$ref": "#/$defs/sha256" },
          "rationale": { "$ref": "#/$defs/nonEmpty" },
          "decision_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "semantic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "evidence_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "manifest_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "absolutePath": { "type": "string", "pattern": "^/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$" },
    "archivePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+$" },
    "sourcePath": { "type": "string", "pattern": "^src/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+\\.(?:ts|tsx)$" },
    "symbol": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
    "exportId": { "type": "string", "pattern": "^\\./(?:color|css|easing|math|path|transform)#[A-Za-z_$][A-Za-z0-9_$]*:(?:type|runtime)$" },
    "survivingSpecifier": { "enum": ["./color", "./css", "./easing", "./math", "./path", "./transform"] },
    "archiveFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/archivePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "declarationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+\\.d\\.(?:cts|mts|ts)$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha512"],
      "properties": {
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//).+\\.(?:cjs|mjs|js)$" },
        "sha512": { "$ref": "#/$defs/sha512" }
      }
    }
  }
}
