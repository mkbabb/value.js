{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/vnext-keyframes-target-transpose-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "wave_id", "scope", "repository", "current_inventory", "target_paths", "local_decisions", "physical_truth", "test_contract", "rows", "introduced_targets", "result", "manifest_hash"],
  "properties": {
    "schema": { "const": "vnext-keyframes-target-transpose/1" },
    "wave_id": { "enum": ["K22T", "M10T"] },
    "scope": { "enum": ["library", "demo"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "head", "dirty_sha256", "repository_state_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "branch": { "$ref": "#/$defs/nonEmpty" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty_sha256": { "$ref": "#/$defs/sha256" },
        "repository_state_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "current_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "inventory_hash", "return"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "inventory_hash": { "$ref": "#/$defs/sha256" },
        "return": { "$ref": "#/$defs/returnEvidence" }
      }
    },
    "target_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "manifest_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "local_decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "annex_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "annex_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "physical_truth": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "receipt_hash"],
      "properties": { "path": { "$ref": "#/$defs/absolutePath" }, "file_sha256": { "$ref": "#/$defs/sha256" }, "receipt_hash": { "$ref": "#/$defs/sha256" } }
    },
    "test_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["script", "command", "loader", "timeout_ms"],
      "properties": {
        "script": { "enum": ["proof:k22t-target-tests", "proof:m10t-target-tests"] },
        "command": { "$ref": "#/$defs/nonEmpty" },
        "loader": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": { "$ref": "#/$defs/relativePath" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 120000 }
      }
    },
    "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
    "introduced_targets": { "type": "array", "items": { "$ref": "#/$defs/introduction" } },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "support_exceptions", "graphs", "delivery"],
      "properties": {
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "support_exceptions": { "type": "array", "items": { "$ref": "#/$defs/supportException" } },
        "delivery": { "$ref": "#/$defs/delivery" },
        "graphs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "type"],
          "properties": { "runtime": { "$ref": "#/$defs/graph" }, "type": { "$ref": "#/$defs/graph" } }
        }
      }
    },
    "manifest_hash": { "$ref": "#/$defs/sha256" }
  },
  "allOf": [
    { "if": { "properties": { "scope": { "const": "library" } }, "required": ["scope"] }, "then": { "properties": { "wave_id": { "const": "K22T" } } } },
    { "if": { "properties": { "scope": { "const": "demo" } }, "required": ["scope"] }, "then": { "properties": { "wave_id": { "const": "M10T" } } } }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//).+$" },
    "waveId": { "type": "string", "pattern": "^[PVKAGDMC][0-9]{2}[A-Z]?$" },
    "returnEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "return_hash"],
      "properties": { "path": { "$ref": "#/$defs/absolutePath" }, "file_sha256": { "$ref": "#/$defs/sha256" }, "return_hash": { "$ref": "#/$defs/sha256" } }
    },
    "decisionOwner": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "wave_id", "return", "decision_id", "decision_hash"],
          "properties": {
            "kind": { "const": "terminal-return" },
            "wave_id": { "$ref": "#/$defs/waveId" },
            "return": { "$ref": "#/$defs/returnEvidence" },
            "decision_id": { "$ref": "#/$defs/nonEmpty" },
            "decision_hash": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "wave_id", "local_decisions", "decision_id", "decision_hash"],
          "properties": {
            "kind": { "const": "local-decision" },
            "wave_id": { "enum": ["K22T", "M10T"] },
            "local_decisions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "file_sha256", "annex_hash"],
              "properties": { "path": { "$ref": "#/$defs/absolutePath" }, "file_sha256": { "$ref": "#/$defs/sha256" }, "annex_hash": { "$ref": "#/$defs/sha256" } }
            },
            "decision_id": { "$ref": "#/$defs/nonEmpty" },
            "decision_hash": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "current_id", "current_sha256", "disposition", "target_id", "target_sha256", "owner", "rationale", "tombstone"],
      "properties": {
        "kind": { "enum": ["source", "test", "support"] },
        "current_id": { "$ref": "#/$defs/relativePath" },
        "current_sha256": { "$ref": "#/$defs/sha256" },
        "disposition": { "enum": ["keep", "move", "fold", "delete"] },
        "target_id": { "oneOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }] },
        "target_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "owner": { "$ref": "#/$defs/decisionOwner" },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "tombstone": { "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "disposition": { "const": "delete" } }, "required": ["disposition"] }, "then": { "properties": { "target_id": { "type": "null" }, "target_sha256": { "type": "null" }, "tombstone": { "$ref": "#/$defs/nonEmpty" } } }, "else": { "properties": { "target_id": { "$ref": "#/$defs/relativePath" }, "target_sha256": { "$ref": "#/$defs/sha256" }, "tombstone": { "type": "null" } } } }
      ]
    },
    "introduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_id", "target_sha256", "owner", "rationale"],
      "properties": {
        "kind": { "enum": ["source", "test", "support"] },
        "target_id": { "$ref": "#/$defs/relativePath" },
        "target_sha256": { "$ref": "#/$defs/sha256" },
        "owner": { "$ref": "#/$defs/decisionOwner" },
        "rationale": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "bytes", "sha256"],
      "properties": {
        "kind": { "enum": ["source", "test", "support"] },
        "path": { "$ref": "#/$defs/relativePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "supportException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "class", "owner_wave_id", "rationale"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "class": { "enum": ["benchmark", "fixture", "proof", "tool"] },
        "owner_wave_id": { "$ref": "#/$defs/waveId" },
        "rationale": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "tests", "support", "removed_paths", "replaced_paths"],
      "properties": {
        "source": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "tests": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "support": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "removed_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "replaced_paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "specifier"],
      "properties": { "from": { "$ref": "#/$defs/relativePath" }, "to": { "$ref": "#/$defs/relativePath" }, "specifier": { "$ref": "#/$defs/nonEmpty" } }
    },
    "externalImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "specifier"],
      "properties": { "from": { "$ref": "#/$defs/relativePath" }, "specifier": { "$ref": "#/$defs/nonEmpty" } }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "external_imports", "sccs", "graph_hash"],
      "properties": {
        "nodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "edges": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/edge" } },
        "external_imports": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/externalImport" } },
        "sccs": { "type": "array", "uniqueItems": true, "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } } },
        "graph_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
