{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/vnext-value-current-inventory-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "wave_id", "repository", "snapshot", "authority", "test_exclusions", "nodes", "inventory_hash"],
  "properties": {
    "schema": { "const": "vnext-value-current-inventory/1" },
    "wave_id": { "const": "V00A" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "head", "dirty_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "branch": { "$ref": "#/$defs/nonEmpty" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "files", "files_sha256"],
      "properties": {
        "root": { "$ref": "#/$defs/absolutePath" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "files_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_root", "test_root", "package_manifest", "node_extensions", "package_manifest_sha256"],
      "properties": {
        "source_root": { "const": "src" },
        "test_root": { "const": "test" },
        "package_manifest": { "const": "package.json" },
        "node_extensions": { "const": [".cjs", ".cts", ".js", ".jsx", ".mjs", ".mts", ".ts", ".tsx"] },
        "package_manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "test_exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "class", "owner", "reason"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "class": { "enum": ["demo", "nonlibrary"] },
          "owner": { "const": "D00A" },
          "reason": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "inventory_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "baseNodeProperties": {
      "kind": { "enum": ["source", "test", "export"] },
      "id": { "$ref": "#/$defs/nonEmpty" },
      "path": { "$ref": "#/$defs/relativePath" },
      "sha256": { "$ref": "#/$defs/sha256" }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "path", "sha256"],
          "properties": {
            "kind": { "enum": ["source", "test"] },
            "id": { "$ref": "#/$defs/nonEmpty" },
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "path", "sha256", "specifier", "symbol", "surface"],
          "properties": {
            "kind": { "const": "export" },
            "id": { "$ref": "#/$defs/nonEmpty" },
            "path": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "specifier": { "$ref": "#/$defs/nonEmpty" },
            "symbol": { "$ref": "#/$defs/nonEmpty" },
            "surface": { "enum": ["type", "runtime"] }
          }
        }
      ]
    }
  }
}
