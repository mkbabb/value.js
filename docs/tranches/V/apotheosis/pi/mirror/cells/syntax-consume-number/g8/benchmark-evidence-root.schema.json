{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:value-js:syntax-consume-number:g8:benchmark-evidence-root",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "generation", "status", "rows", "closure_sha256"],
  "properties": {
    "feature_id": { "const": "SYNTAX-CONSUME-NUMBER" }, "generation": { "const": 8 }, "status": { "const": "EXACT_IMMUTABLE_EVIDENCE_ROOT" },
    "rows": { "type": "array", "minItems": 35, "items": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "sha256", "bytes"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }, "kind": { "enum": ["pre-author", "feature", "public-corpus", "revealed-holdout-corpus", "normalized-observations", "candidate-source", "author-receipt", "build-manifest", "bundle", "public-correctness", "holdout-correctness", "comparator-build", "comparator-bundle", "comparator-correctness", "runner", "schedule"] }, "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 } } } },
    "closure_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
