{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:value-js:syntax-consume-number:g6:benchmark-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "generation", "attempt_id", "run_manifest", "raw_result", "peer_keys", "selected_candidate", "summaries", "paired_candidate_over_peer", "strict_wins", "allocation", "invocations", "exits", "failures", "throughput_unit", "recomputed_by", "credit"],
  "properties": {
    "feature_id": { "const": "SYNTAX-CONSUME-NUMBER" }, "generation": { "const": 6 }, "attempt_id": { "type": "string", "minLength": 1 },
    "run_manifest": { "$ref": "#/$defs/identityRow" }, "raw_result": { "$ref": "#/$defs/identityRow" },
    "peer_keys": { "const": ["h", "b", "s", "d", "live-regex", "deposed", "c14"] }, "selected_candidate": { "enum": ["h", "b", "s", "d"] },
    "summaries": { "$ref": "#/$defs/allSubjects" },
    "paired_candidate_over_peer": { "type": "object", "additionalProperties": false, "required": ["h", "b", "s", "d", "live-regex", "deposed", "c14"], "properties": { "h": { "$ref": "#/$defs/ratioOrNull" }, "b": { "$ref": "#/$defs/ratioOrNull" }, "s": { "$ref": "#/$defs/ratioOrNull" }, "d": { "$ref": "#/$defs/ratioOrNull" }, "live-regex": { "$ref": "#/$defs/ratioOrNull" }, "deposed": { "$ref": "#/$defs/ratioOrNull" }, "c14": { "$ref": "#/$defs/ratioOrNull" } } },
    "strict_wins": { "type": "object", "additionalProperties": false, "required": ["h", "b", "s", "d", "live-regex", "deposed", "c14"], "properties": { "h": { "$ref": "#/$defs/win" }, "b": { "$ref": "#/$defs/win" }, "s": { "$ref": "#/$defs/win" }, "d": { "$ref": "#/$defs/win" }, "live-regex": { "$ref": "#/$defs/win" }, "deposed": { "$ref": "#/$defs/win" }, "c14": { "$ref": "#/$defs/win" } } },
    "allocation": { "type": "object", "additionalProperties": false, "required": ["status", "tool", "reason", "evidence_sha256"], "properties": { "status": { "enum": ["MEASURED", "UNAVAILABLE"] }, "tool": { "type": "string", "minLength": 1 }, "reason": { "type": "string", "minLength": 1 }, "evidence_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] } } },
    "invocations": { "type": "integer", "minimum": 1 }, "exits": { "type": "array", "minItems": 1, "items": { "type": "integer" } }, "failures": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "throughput_unit": { "const": "UTF16_CODE_UNITS_PER_SECOND" }, "recomputed_by": { "const": "benchmark-validator.mjs" }, "credit": { "const": "ZERO_UNTIL_SKEPTIC_AND_ADJUDICATOR_ACCEPTANCE" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "identityRow": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes"], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 } } },
    "subjectSummary": { "type": "object", "additionalProperties": false, "required": ["status", "median_ms", "mad_ms", "invocations", "exit_code", "failures", "throughput"], "properties": { "status": { "enum": ["MEASURED", "FAILED", "NON_COMPARABLE"] }, "median_ms": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "mad_ms": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] }, "invocations": { "type": "integer", "minimum": 0 }, "exit_code": { "oneOf": [{ "type": "integer" }, { "type": "null" }] }, "failures": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "throughput": { "oneOf": [{ "type": "number", "minimum": 0 }, { "type": "null" }] } } },
    "allSubjects": { "type": "object", "additionalProperties": false, "required": ["h", "b", "s", "d", "live-regex", "deposed", "c14"], "properties": { "h": { "$ref": "#/$defs/subjectSummary" }, "b": { "$ref": "#/$defs/subjectSummary" }, "s": { "$ref": "#/$defs/subjectSummary" }, "d": { "$ref": "#/$defs/subjectSummary" }, "live-regex": { "$ref": "#/$defs/subjectSummary" }, "deposed": { "$ref": "#/$defs/subjectSummary" }, "c14": { "$ref": "#/$defs/subjectSummary" } } },
    "ratioOrNull": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["geometric_mean_ratio", "upper_confidence_bound"], "properties": { "geometric_mean_ratio": { "type": "number", "exclusiveMinimum": 0 }, "upper_confidence_bound": { "type": "number", "exclusiveMinimum": 0 } } }, { "type": "null" }] },
    "win": { "enum": [true, false, "NON_COMPARABLE", "SELF"] }
  }
}
