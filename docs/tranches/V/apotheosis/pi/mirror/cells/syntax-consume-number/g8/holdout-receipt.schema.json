{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:value-js:syntax-consume-number:g8:holdout-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "generation", "status", "custodian", "precursor", "generator", "plaintext_commitment", "ciphertext", "coverage", "comparison_inputs", "custody", "protocol", "public_verifiability", "absence_freshness", "credit"],
  "properties": {
    "feature_id": { "const": "SYNTAX-CONSUME-NUMBER" },
    "generation": { "const": 8 },
    "status": { "const": "SEALED_PRE_AUTHOR_CIPHERTEXT_ONLY_ZERO_FEATURE_CREDIT" },
    "custodian": { "type": "object", "additionalProperties": false, "required": ["id", "served_model", "reasoning_effort", "independent", "candidate_source_access", "commands", "closed_at"], "properties": { "id": { "type": "string", "minLength": 1 }, "served_model": { "type": "string", "minLength": 1 }, "reasoning_effort": { "type": "string", "minLength": 1 }, "independent": { "const": true }, "candidate_source_access": { "const": false }, "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "closed_at": { "type": "string", "format": "date-time" } } },
    "precursor": { "type": "object", "additionalProperties": false, "required": ["formation", "rows", "closure_sha256"], "properties": { "formation": { "$ref": "#/$defs/idRow" }, "rows": { "type": "integer", "minimum": 1 }, "closure_sha256": { "$ref": "#/$defs/sha256" } } },
    "generator": { "type": "object", "additionalProperties": false, "required": ["bytes", "method", "canonicalization", "hidden_index_commitment"], "properties": { "bytes": { "$ref": "#/$defs/idRow" }, "method": { "type": "string", "minLength": 1 }, "canonicalization": { "type": "string", "minLength": 1 }, "hidden_index_commitment": { "$ref": "#/$defs/idRow" } } },
    "plaintext_commitment": { "$ref": "#/$defs/idRow" },
    "ciphertext": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "encoding", "decoded_envelope_bytes", "algorithm", "magic_ascii_nul", "nonce_bytes", "tag_bytes", "aad_sha256"], "properties": { "path": { "const": "holdout-ciphertext.b64" }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 }, "encoding": { "const": "base64-with-final-lf" }, "decoded_envelope_bytes": { "type": "integer", "minimum": 37 }, "algorithm": { "const": "AES-256-GCM" }, "magic_ascii_nul": { "const": "VPI8CN1\u0000" }, "nonce_bytes": { "const": 12 }, "tag_bytes": { "const": 16 }, "aad_sha256": { "$ref": "#/$defs/sha256" } } },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["case_count", "unique_case_ids", "categories", "canonical_hidden_cases_sha256", "public_case_ids_sha256"], "properties": { "case_count": { "type": "integer", "minimum": 1 }, "unique_case_ids": { "type": "integer", "minimum": 1 }, "categories": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "enum": ["positive", "negative", "boundary", "offset", "diagnostics", "hostile", "binary64", "composition"] } }, "canonical_hidden_cases_sha256": { "$ref": "#/$defs/sha256" }, "public_case_ids_sha256": { "$ref": "#/$defs/sha256" } } },
    "comparison_inputs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/pathRow" } },
    "custody": { "type": "object", "additionalProperties": false, "required": ["secret_location", "key_recoverable_until", "plaintext_workspace_files", "key_workspace_files", "generator_workspace_files"], "properties": { "secret_location": { "type": "string", "minLength": 1 }, "key_recoverable_until": { "const": "POST_AUTHOR_REVEAL_OR_TERMINAL_REJECTION" }, "plaintext_workspace_files": { "const": 0 }, "key_workspace_files": { "const": 0 }, "generator_workspace_files": { "const": 0 } } },
    "protocol": { "type": "object", "additionalProperties": false, "required": ["reveal_trigger", "reveal_verifier", "destruction_trigger", "destruction_receipt_required", "no_reuse"], "properties": { "reveal_trigger": { "const": "AFTER_ALL_FOUR_EXACT_CANDIDATE_PAYLOADS_CLOSE" }, "reveal_verifier": { "type": "string", "minLength": 1 }, "destruction_trigger": { "const": "AFTER_REVEAL_VERIFICATION_OR_TERMINAL_PRE_AUTHOR_REJECTION" }, "destruction_receipt_required": { "const": true }, "no_reuse": { "const": true } } },
    "public_verifiability": { "type": "object", "additionalProperties": false, "required": ["pre_reveal_proves", "pre_reveal_cannot_prove", "post_reveal_recomputes"], "properties": { "pre_reveal_proves": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "pre_reveal_cannot_prove": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "post_reveal_recomputes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } } },
    "absence_freshness": { "type": "object", "additionalProperties": false, "required": ["candidate_sources_existed", "candidate_sources_accessed", "prior_secret_material_reused", "fresh_key", "fresh_nonce", "fresh_corpus_id"], "properties": { "candidate_sources_existed": { "const": false }, "candidate_sources_accessed": { "const": false }, "prior_secret_material_reused": { "const": false }, "fresh_key": { "const": true }, "fresh_nonce": { "const": true }, "fresh_corpus_id": { "const": true } } },
    "credit": { "const": "ZERO_SEALING_ONLY" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "idRow": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes"], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 } } },
    "pathRow": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 } } }
  }
}
