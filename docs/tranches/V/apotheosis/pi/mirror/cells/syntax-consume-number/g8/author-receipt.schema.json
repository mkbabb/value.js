{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:value-js:syntax-consume-number:g8:author-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "generation", "seat", "author_id", "independent", "delivery", "admission", "candidate", "construction", "credit"],
  "properties": {
    "feature_id": { "const": "SYNTAX-CONSUME-NUMBER" }, "generation": { "const": 8 }, "seat": { "enum": ["h", "b", "s", "d"] }, "author_id": { "type": "string", "minLength": 1 }, "independent": { "const": true },
    "delivery": { "type": "object", "additionalProperties": false, "required": ["seat_manifest_sha256", "seat_manifest_bytes", "delivered_input_closure_sha256", "delivered_input_row_count", "common_law_sha256", "seat_packet_sha256", "peer_packets", "peer_source", "peer_notes", "isolated_root"], "properties": { "seat_manifest_sha256": { "$ref": "#/$defs/sha256" }, "seat_manifest_bytes": { "type": "integer", "minimum": 1 }, "delivered_input_closure_sha256": { "$ref": "#/$defs/sha256" }, "delivered_input_row_count": { "type": "integer", "minimum": 4 }, "common_law_sha256": { "$ref": "#/$defs/sha256" }, "seat_packet_sha256": { "$ref": "#/$defs/sha256" }, "peer_packets": { "const": false }, "peer_source": { "const": false }, "peer_notes": { "const": false }, "isolated_root": { "const": true } } },
    "admission": { "type": "object", "additionalProperties": false, "required": ["boundary_manifest_sha256", "pre_author_receipt_sha256", "formation_sha256"], "properties": { "boundary_manifest_sha256": { "$ref": "#/$defs/sha256" }, "pre_author_receipt_sha256": { "$ref": "#/$defs/sha256" }, "formation_sha256": { "$ref": "#/$defs/sha256" } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["payload_closure_sha256", "source_path", "source_sha256", "source_bytes", "detached_receipt_excluded"], "properties": { "payload_closure_sha256": { "$ref": "#/$defs/sha256" }, "source_path": { "type": "string", "pattern": "^overlay/grammar/css/l4/value-unit/consume-number\\.ts$" }, "source_sha256": { "$ref": "#/$defs/sha256" }, "source_bytes": { "type": "integer", "minimum": 1 }, "detached_receipt_excluded": { "const": true } } },
    "construction": { "type": "object", "additionalProperties": false, "required": ["parse_that_apis", "loc", "backtracking_shape", "material_intermediate_allocations", "known_compromises"], "properties": { "parse_that_apis": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "loc": { "type": "integer", "minimum": 1 }, "backtracking_shape": { "type": "string", "minLength": 1 }, "material_intermediate_allocations": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "known_compromises": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "credit": { "const": "ZERO_AUTHOR_RECEIPT_ONLY" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
