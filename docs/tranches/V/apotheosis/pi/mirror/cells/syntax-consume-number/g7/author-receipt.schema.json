{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:value-js:syntax-consume-number:g7:author-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "generation", "seat", "author_id", "served_model", "reasoning_effort", "independent", "peer_source_access", "admission", "candidate", "commands", "closed_at", "construction", "provenance", "credit"],
  "properties": {
    "feature_id": { "const": "SYNTAX-CONSUME-NUMBER" }, "generation": { "const": 7 }, "seat": { "enum": ["h", "b", "s", "d"] },
    "author_id": { "type": "string", "minLength": 1 }, "served_model": { "type": "string", "minLength": 1 }, "reasoning_effort": { "type": "string", "minLength": 1 },
    "independent": { "const": true }, "peer_source_access": { "const": false },
    "admission": { "type": "object", "additionalProperties": false, "required": ["admitted_manifest_sha256", "pre_author_receipt_sha256", "formation_sha256"], "properties": { "admitted_manifest_sha256": { "$ref": "#/$defs/sha256" }, "pre_author_receipt_sha256": { "$ref": "#/$defs/sha256" }, "formation_sha256": { "$ref": "#/$defs/sha256" } } },
    "candidate": { "type": "object", "additionalProperties": false, "required": ["isolated_root_sha256", "source_path", "source_sha256", "source_bytes"], "properties": { "isolated_root_sha256": { "$ref": "#/$defs/sha256" }, "source_path": { "type": "string", "minLength": 1 }, "source_sha256": { "$ref": "#/$defs/sha256" }, "source_bytes": { "type": "integer", "minimum": 1 } } },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "closed_at": { "type": "string", "format": "date-time" },
    "construction": {
      "type": "object", "additionalProperties": false,
      "required": ["parse_that_apis", "loc", "backtracking_shape", "material_intermediate_allocations", "known_compromises"],
      "properties": {
        "parse_that_apis": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "loc": { "type": "integer", "minimum": 1 }, "backtracking_shape": { "type": "string", "minLength": 1 },
        "material_intermediate_allocations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "known_compromises": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["lineage_sha256", "seat_input_sha256s", "peer_design_notes_accessed", "candidate_root_isolated"], "properties": { "lineage_sha256": { "$ref": "#/$defs/sha256" }, "seat_input_sha256s": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }, "peer_design_notes_accessed": { "const": false }, "candidate_root_isolated": { "const": true } } },
    "credit": { "const": "ZERO_AUTHOR_RECEIPT_ONLY" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
