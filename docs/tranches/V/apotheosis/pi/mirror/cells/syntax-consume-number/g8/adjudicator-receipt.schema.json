{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:value-js:syntax-consume-number:g8:adjudicator-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "generation", "role", "adjudicator", "candidate_set", "skeptic_receipts_closure_sha256", "nomination", "reasoning", "credit"],
  "properties": {
    "feature_id": { "const": "SYNTAX-CONSUME-NUMBER" }, "generation": { "const": 8 }, "role": { "enum": ["semantic", "parser-architecture", "performance-gestalt"] },
    "adjudicator": { "type": "object", "additionalProperties": false, "required": ["id", "served_model", "independent", "author", "boundary_reviewer", "root", "skeptic", "peer_adjudication_access_before_seal"], "properties": { "id": { "type": "string", "minLength": 1 }, "served_model": { "type": "string", "minLength": 1 }, "independent": { "const": true }, "author": { "const": false }, "boundary_reviewer": { "const": false }, "root": { "const": false }, "skeptic": { "const": false }, "peer_adjudication_access_before_seal": { "const": false } } },
    "candidate_set": { "type": "object", "additionalProperties": false, "required": ["sha256", "bytes", "set_closure_sha256"], "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "bytes": { "type": "integer", "minimum": 1 }, "set_closure_sha256": { "$ref": "#/$defs/sha256" } } },
    "skeptic_receipts_closure_sha256": { "$ref": "#/$defs/sha256" },
    "nomination": { "type": "object", "additionalProperties": false, "required": ["seat", "payload_closure_sha256", "already_reviewed", "unblocked", "unseen_composite"], "properties": { "seat": { "enum": ["h", "b", "s", "d"] }, "payload_closure_sha256": { "$ref": "#/$defs/sha256" }, "already_reviewed": { "const": true }, "unblocked": { "const": true }, "unseen_composite": { "const": false } } },
    "reasoning": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "credit": { "const": "ZERO_ADJUDICATION_RECEIPT_ONLY" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
