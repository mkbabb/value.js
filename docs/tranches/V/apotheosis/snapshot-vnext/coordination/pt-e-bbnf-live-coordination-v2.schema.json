{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/pt-e-bbnf-live-2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "stream_id", "events"],
  "properties": {
    "format": { "const": "pt-e-bbnf-live/2" },
    "stream_id": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "branch", "head", "dirty_count", "dirty_sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty_count": { "type": "integer", "minimum": 0 },
        "dirty_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_js", "parse_that", "bbnf_lang"],
      "properties": {
        "value_js": { "$ref": "#/$defs/pin" },
        "parse_that": { "$ref": "#/$defs/pin" },
        "bbnf_lang": { "$ref": "#/$defs/pin" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordination_only", "imports_active_novelty", "mutates_bbnf", "mutation_owner"],
      "properties": {
        "coordination_only": { "const": true },
        "imports_active_novelty": { "const": false },
        "mutates_bbnf": { "const": false },
        "mutation_owner": { "enum": ["none", "vnext-p03", "active-pt-major"] }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_model", "public_combinator_family", "tape_soa_pratt", "package_topology", "bbnf_grammar_emitter", "active_prototype_code"],
      "properties": {
        "execution_model": { "const": false },
        "public_combinator_family": { "const": false },
        "tape_soa_pratt": { "const": false },
        "package_topology": { "const": false },
        "bbnf_grammar_emitter": { "const": false },
        "active_prototype_code": { "const": false }
      }
    },
    "cssUnionFreeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "scope", "source_thread_id", "bbnf_commit", "module_manifest_sha256", "runtime_modules_sha256", "excluded_dispositions_sha256", "resolved_edges_sha256", "imports_parse_that_novelty"],
      "properties": {
        "state": { "const": "frozen" },
        "scope": { "const": "snapshot-2026-constituents-and-exceptions-plus-every-w3c-level-4-module-plus-css-syntax-and-normative-dependencies" },
        "source_thread_id": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
        "bbnf_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "module_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_modules_sha256": { "$ref": "#/$defs/sha256" },
        "excluded_dispositions_sha256": { "$ref": "#/$defs/sha256" },
        "resolved_edges_sha256": { "$ref": "#/$defs/sha256" },
        "imports_parse_that_novelty": { "const": false }
      }
    },
    "event": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["sequence", "kind", "created_at", "previous_event_sha256", "event_sha256", "pins", "authority", "evidence"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["snapshot", "mutation_intent", "acknowledgement", "close"] },
        "created_at": { "type": "string", "format": "date-time" },
        "previous_event_sha256": { "oneOf": [{ "const": "genesis" }, { "$ref": "#/$defs/sha256" }] },
        "event_sha256": { "$ref": "#/$defs/sha256" },
        "pins": { "$ref": "#/$defs/pins" },
        "authority": { "$ref": "#/$defs/authority" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "wave_id": { "enum": ["P00", "P02", "P07"] },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": { "name": { "const": "@mkbabb/parse-that" }, "version": { "const": "1.0.0" } }
        },
        "active": {
          "type": "object",
          "additionalProperties": false,
          "required": ["campaign", "coordination_index_sha256", "v3_prototype_tree_sha256", "bbnf_campaign_tree_sha256", "production_authority"],
          "properties": {
            "campaign": { "const": "SK-V25" },
            "coordination_index_sha256": { "$ref": "#/$defs/sha256" },
            "v3_prototype_tree_sha256": { "$ref": "#/$defs/sha256" },
            "bbnf_campaign_tree_sha256": { "$ref": "#/$defs/sha256" },
            "production_authority": { "const": false }
          }
        },
        "active_locks": { "$ref": "#/$defs/stringArray" },
        "defect_ids": { "$ref": "#/$defs/stringArray" },
        "vnext_publication_branches": {
          "oneOf": [
            { "const": ["unchanged-1.0.0-no-republish", "compatible-1.0.1"] },
            { "const": ["unchanged-1.0.0-no-republish"] }
          ]
        },
        "v1_historical_sha256": { "$ref": "#/$defs/sha256" },
        "acknowledgement_required_before_p03": { "const": true },
        "css_union_freeze": { "$ref": "#/$defs/cssUnionFreeze" },
        "snapshot_event_sha256": { "$ref": "#/$defs/sha256" },
        "p01_return_sha256": { "$ref": "#/$defs/sha256" },
        "css_corpus_sha256": { "$ref": "#/$defs/sha256" },
        "css_projection_sha256": { "$ref": "#/$defs/sha256" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defect_id", "red_fixture_sha256", "affected_paths", "affected_symbols", "active_locks", "proposed_patch_sha256", "proposed_version", "novelty"],
            "properties": {
              "defect_id": { "type": "string", "minLength": 1 },
              "red_fixture_sha256": { "$ref": "#/$defs/sha256" },
              "affected_paths": { "$ref": "#/$defs/stringArray" },
              "affected_symbols": { "$ref": "#/$defs/stringArray" },
              "active_locks": { "$ref": "#/$defs/stringArray" },
              "proposed_patch_sha256": { "$ref": "#/$defs/sha256" },
              "proposed_version": { "const": "1.0.1" },
              "novelty": { "$ref": "#/$defs/novelty" }
            }
          }
        },
        "intent_event_sha256": { "$ref": "#/$defs/sha256" },
        "responder_pins": { "$ref": "#/$defs/pins" },
        "disposition": { "enum": ["no-change-observed", "vnext-narrow-fix-cleared", "major-session-owned", "repin-required"] },
        "overlap_locks": { "$ref": "#/$defs/stringArray" },
        "overlap_paths": { "$ref": "#/$defs/stringArray" },
        "writer": { "enum": ["none", "vnext-p03", "active-pt-major"] },
        "ordering": { "enum": ["no-mutation", "vnext-first", "major-first", "repin"] },
        "expires_on_pin_drift": { "const": true },
        "intent_and_ack": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["applicability", "reason"],
              "properties": { "applicability": { "const": "not_applicable" }, "reason": { "type": "string", "minLength": 1 } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["applicability", "intent_event_sha256", "ack_event_sha256"],
              "properties": {
                "applicability": { "const": "applicable" },
                "intent_event_sha256": { "$ref": "#/$defs/sha256" },
                "ack_event_sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        },
        "accepted_branch": { "enum": ["unchanged-1.0.0-no-republish", "candidate-1.0.1"] },
        "p04_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "p07_return_sha256": { "$ref": "#/$defs/sha256" },
        "adopts_active_candidate": { "const": false },
        "outbound_to_major": { "const": true },
        "publication_owner": { "const": "C10" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "snapshot" } } },
          "then": { "required": ["wave_id", "package", "active", "active_locks", "defect_ids", "vnext_publication_branches", "v1_historical_sha256", "acknowledgement_required_before_p03"] }
        },
        {
          "if": { "properties": { "kind": { "const": "mutation_intent" } } },
          "then": { "required": ["wave_id", "snapshot_event_sha256", "p01_return_sha256", "css_corpus_sha256", "css_projection_sha256", "candidates"] }
        },
        {
          "if": { "properties": { "kind": { "const": "acknowledgement" } } },
          "then": { "required": ["intent_event_sha256", "responder_pins", "disposition", "overlap_locks", "overlap_paths", "writer", "ordering", "expires_on_pin_drift"] }
        },
        {
          "if": { "properties": { "kind": { "const": "close" } } },
          "then": { "required": ["wave_id", "snapshot_event_sha256", "intent_and_ack", "accepted_branch", "p04_receipt_sha256", "p07_return_sha256", "adopts_active_candidate", "outbound_to_major", "publication_owner"] }
        }
      ]
    }
  }
}
