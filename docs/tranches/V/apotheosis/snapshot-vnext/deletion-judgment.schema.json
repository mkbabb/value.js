{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/vnext-deletion-judgment-1.json",
  "title": "Executable deletion judgment and total-join annex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "wave_id",
    "consumer_scan",
    "truth_receipts",
    "delivery_deleted",
    "disposition_deletions",
    "ancestor_returns",
    "decisions",
    "c10_removed_surfaces",
    "annex_hash"
  ],
  "properties": {
    "schema": { "const": "vnext-deletion-judgment/1" },
    "phase": { "enum": ["owner-precut", "c05-rehearsal", "c10-final"] },
    "wave_id": { "$ref": "#/$defs/waveId" },
    "consumer_scan": { "$ref": "#/$defs/consumerScan" },
    "truth_receipts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/truthReceipt" }
    },
    "delivery_deleted": {
      "type": "array",
      "items": { "$ref": "#/$defs/deletionRef" }
    },
    "disposition_deletions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "file_effects"],
        "properties": {
          "decision_id": { "$ref": "#/$defs/decisionId" },
          "file_effects": { "$ref": "#/$defs/fileEffects" }
        }
      }
    },
    "ancestor_returns": {
      "type": "array",
      "items": { "$ref": "#/$defs/returnBinding" }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    },
    "c10_removed_surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "decision_hash", "owner_wave", "surface", "tombstone"],
        "properties": {
          "decision_id": { "$ref": "#/$defs/decisionId" },
          "decision_hash": { "$ref": "#/$defs/sha256" },
          "owner_wave": { "$ref": "#/$defs/waveId" },
          "surface": { "$ref": "#/$defs/nonEmpty" },
          "tombstone": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "annex_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "absolutePath": { "type": "string", "pattern": "^/", "minLength": 2 },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\).+$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "waveId": { "type": "string", "pattern": "^[PVKAGDMC][0-9]{2}[A-Z]?$" },
    "rootId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
    "decisionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "description"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "description": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "evidenceArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "consumerBoundsAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "manifest_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "deletionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "path"],
      "properties": {
        "root_id": { "$ref": "#/$defs/rootId" },
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "fileEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "path", "truth_receipt_hash"],
      "properties": {
        "root_id": { "$ref": "#/$defs/rootId" },
        "path": { "$ref": "#/$defs/relativePath" },
        "truth_receipt_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "fileEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deleted", "modified"],
      "properties": {
        "deleted": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileEffect" }
        },
        "modified": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileEffect" }
        }
      }
    },
    "consumerScan": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "receipt_path", "receipt_file_sha256", "receipt_hash", "input_path", "input_file_sha256", "universe_hash", "resolver_sha256", "input_schema_sha256", "receipt_schema_sha256", "bounds_authority", "bounds_sha256", "formation_wave_registry_sha256", "observed_at", "resolved_at", "epoch", "counts", "roots_sha256", "edges_sha256", "resolvable", "blockers"],
          "properties": {
            "authority": { "const": "owner-precut" },
            "receipt_path": { "$ref": "#/$defs/absolutePath" },
            "receipt_file_sha256": { "$ref": "#/$defs/sha256" },
            "receipt_hash": { "$ref": "#/$defs/sha256" },
            "input_path": { "$ref": "#/$defs/absolutePath" },
            "input_file_sha256": { "$ref": "#/$defs/sha256" },
            "universe_hash": { "$ref": "#/$defs/sha256" },
            "resolver_sha256": { "$ref": "#/$defs/sha256" },
            "input_schema_sha256": { "$ref": "#/$defs/sha256" },
            "receipt_schema_sha256": { "$ref": "#/$defs/sha256" },
            "bounds_authority": { "$ref": "#/$defs/consumerBoundsAuthority" },
            "bounds_sha256": { "$ref": "#/$defs/sha256" },
            "formation_wave_registry_sha256": { "$ref": "#/$defs/sha256" },
            "observed_at": { "type": "string", "format": "date-time" },
            "resolved_at": { "type": "string", "format": "date-time" },
            "epoch": { "$ref": "#/$defs/consumerEpoch" },
            "counts": { "$ref": "#/$defs/consumerCounts" },
            "roots_sha256": { "$ref": "#/$defs/sha256" },
            "edges_sha256": { "$ref": "#/$defs/sha256" },
            "resolvable": { "type": "boolean" },
            "blockers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "receipt_path", "receipt_file_sha256", "receipt_hash", "input_path", "input_file_sha256", "universe_hash", "resolver_sha256", "input_schema_sha256", "receipt_schema_sha256", "bounds_authority", "bounds_sha256", "formation_wave_registry_sha256", "observed_at", "resolved_at", "epoch", "counts", "roots_sha256", "edges_sha256", "resolvable", "blockers"],
          "properties": {
            "authority": { "const": "c05-rehearsal" },
            "receipt_path": { "$ref": "#/$defs/absolutePath" },
            "receipt_file_sha256": { "$ref": "#/$defs/sha256" },
            "receipt_hash": { "$ref": "#/$defs/sha256" },
            "input_path": { "$ref": "#/$defs/absolutePath" },
            "input_file_sha256": { "$ref": "#/$defs/sha256" },
            "universe_hash": { "$ref": "#/$defs/sha256" },
            "resolver_sha256": { "$ref": "#/$defs/sha256" },
            "input_schema_sha256": { "$ref": "#/$defs/sha256" },
            "receipt_schema_sha256": { "$ref": "#/$defs/sha256" },
            "bounds_authority": { "$ref": "#/$defs/consumerBoundsAuthority" },
            "bounds_sha256": { "$ref": "#/$defs/sha256" },
            "formation_wave_registry_sha256": { "$ref": "#/$defs/sha256" },
            "observed_at": { "type": "string", "format": "date-time" },
            "resolved_at": { "type": "string", "format": "date-time" },
            "epoch": { "$ref": "#/$defs/consumerEpoch" },
            "counts": { "$ref": "#/$defs/consumerCounts" },
            "roots_sha256": { "$ref": "#/$defs/sha256" },
            "edges_sha256": { "$ref": "#/$defs/sha256" },
            "resolvable": { "type": "boolean" },
            "blockers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "receipt_path", "receipt_file_sha256", "receipt_hash", "input_path", "input_file_sha256", "universe_hash", "resolver_sha256", "input_schema_sha256", "receipt_schema_sha256", "bounds_authority", "bounds_sha256", "formation_wave_registry_sha256", "observed_at", "resolved_at", "epoch", "counts", "roots_sha256", "edges_sha256", "resolvable", "blockers", "c05_return", "baseline_deletion_annex_hash", "baseline_receipt_hash", "baseline_epoch_sha256", "root_delta", "edge_delta"],
          "properties": {
            "authority": { "const": "c10-final" },
            "receipt_path": { "$ref": "#/$defs/absolutePath" },
            "receipt_file_sha256": { "$ref": "#/$defs/sha256" },
            "receipt_hash": { "$ref": "#/$defs/sha256" },
            "input_path": { "$ref": "#/$defs/absolutePath" },
            "input_file_sha256": { "$ref": "#/$defs/sha256" },
            "universe_hash": { "$ref": "#/$defs/sha256" },
            "resolver_sha256": { "$ref": "#/$defs/sha256" },
            "input_schema_sha256": { "$ref": "#/$defs/sha256" },
            "receipt_schema_sha256": { "$ref": "#/$defs/sha256" },
            "bounds_authority": { "$ref": "#/$defs/consumerBoundsAuthority" },
            "bounds_sha256": { "$ref": "#/$defs/sha256" },
            "roots_sha256": { "$ref": "#/$defs/sha256" },
            "formation_wave_registry_sha256": { "$ref": "#/$defs/sha256" },
            "observed_at": { "type": "string", "format": "date-time" },
            "resolved_at": { "type": "string", "format": "date-time" },
            "epoch": { "$ref": "#/$defs/consumerEpoch" },
            "counts": { "$ref": "#/$defs/consumerCounts" },
            "edges_sha256": { "$ref": "#/$defs/sha256" },
            "resolvable": { "type": "boolean" },
            "blockers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
            "c05_return": { "$ref": "#/$defs/returnBinding" },
            "baseline_deletion_annex_hash": { "$ref": "#/$defs/sha256" },
            "baseline_receipt_hash": { "$ref": "#/$defs/sha256" },
            "baseline_epoch_sha256": { "$ref": "#/$defs/sha256" },
            "root_delta": { "type": "array", "items": { "$ref": "#/$defs/deltaRow" } },
            "edge_delta": { "type": "array", "items": { "$ref": "#/$defs/deltaRow" } }
          }
        }
      ]
    },
    "consumerEpoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "completed_at", "max_age_seconds", "bounds_sha256", "observed_roots_sha256", "observed_edges_sha256", "epoch_sha256"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "max_age_seconds": { "type": "integer", "minimum": 1 },
        "bounds_sha256": { "$ref": "#/$defs/sha256" },
        "observed_roots_sha256": { "$ref": "#/$defs/sha256" },
        "observed_edges_sha256": { "$ref": "#/$defs/sha256" },
        "epoch_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "consumerCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "included_roots", "excluded_roots", "unavailable_roots", "edges", "included_edges", "excluded_edges", "unavailable_edges", "observations"],
      "properties": {
        "roots": { "type": "integer", "minimum": 0 },
        "included_roots": { "type": "integer", "minimum": 0 },
        "excluded_roots": { "type": "integer", "minimum": 0 },
        "unavailable_roots": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "included_edges": { "type": "integer", "minimum": 0 },
        "excluded_edges": { "type": "integer", "minimum": 0 },
        "unavailable_edges": { "type": "integer", "minimum": 0 },
        "observations": { "type": "integer", "minimum": 0 }
      }
    },
    "truthReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_wave", "root_id", "path", "file_sha256", "receipt_hash"],
      "properties": {
        "owner_wave": { "$ref": "#/$defs/waveId" },
        "root_id": { "$ref": "#/$defs/rootId" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "receipt_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "deltaRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "change", "before_sha256", "after_sha256", "owner_wave", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "change": { "enum": ["added", "removed", "changed"] },
        "before_sha256": { "type": "string", "pattern": "^(?:absent|[0-9a-f]{64})$" },
        "after_sha256": { "type": "string", "pattern": "^(?:absent|[0-9a-f]{64})$" },
        "owner_wave": { "$ref": "#/$defs/waveId" },
        "evidence": { "$ref": "#/$defs/evidenceArray" }
      }
    },
    "returnBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave_id", "path", "file_sha256", "return_hash", "status"],
      "properties": {
        "wave_id": { "$ref": "#/$defs/waveId" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "return_hash": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["COMPLETE", "KEEP", "PRUNE"] }
      }
    },
    "origin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "current-wave" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner_return_hash"],
          "properties": {
            "kind": { "const": "ancestor-return" },
            "owner_return_hash": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "replacement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "capability", "owner_wave", "owner_return_hash", "evidence"],
          "properties": {
            "applicability": { "const": "applicable" },
            "capability": { "$ref": "#/$defs/nonEmpty" },
            "owner_wave": { "$ref": "#/$defs/waveId" },
            "owner_return_hash": { "$ref": "#/$defs/sha256" },
            "evidence": { "$ref": "#/$defs/evidenceArray" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "reason", "evidence"],
          "properties": {
            "applicability": { "const": "not_applicable" },
            "reason": { "$ref": "#/$defs/nonEmpty" },
            "evidence": { "$ref": "#/$defs/evidenceArray" }
          }
        }
      ]
    },
    "casualty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "consumer_root_id", "import_or_behavior", "migration_owner", "migration_return_hash", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/decisionId" },
        "consumer_root_id": { "$ref": "#/$defs/rootId" },
        "import_or_behavior": { "$ref": "#/$defs/nonEmpty" },
        "migration_owner": { "$ref": "#/$defs/waveId" },
        "migration_return_hash": { "$ref": "#/$defs/sha256" },
        "evidence": { "$ref": "#/$defs/evidenceArray" }
      }
    },
    "rootCasualtyDisposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_id", "status", "evidence"],
          "properties": {
            "root_id": { "$ref": "#/$defs/rootId" },
            "status": { "const": "unaffected" },
            "evidence": { "$ref": "#/$defs/evidenceArray" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_id", "status", "casualties"],
          "properties": {
            "root_id": { "$ref": "#/$defs/rootId" },
            "status": { "const": "migrated" },
            "casualties": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/casualty" }
            }
          }
        }
      ]
    },
    "casualtyScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer_receipt_hash", "patterns", "roots", "active_hits", "allowed_hits", "scan_sha256"],
      "properties": {
        "consumer_receipt_hash": { "$ref": "#/$defs/sha256" },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rootCasualtyDisposition" }
        },
        "active_hits": {
          "type": "array",
          "items": { "$ref": "#/$defs/scanHit" }
        },
        "allowed_hits": {
          "type": "array",
          "items": { "$ref": "#/$defs/allowedHit" }
        },
        "scan_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scanHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "path", "pattern", "line", "file_sha256"],
      "properties": {
        "root_id": { "$ref": "#/$defs/rootId" },
        "path": { "$ref": "#/$defs/relativePath" },
        "pattern": { "$ref": "#/$defs/nonEmpty" },
        "line": { "type": "integer", "minimum": 1 },
        "file_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "allowedHit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_id", "path", "pattern", "line", "file_sha256", "classification", "reason", "evidence"],
      "properties": {
        "root_id": { "$ref": "#/$defs/rootId" },
        "path": { "$ref": "#/$defs/relativePath" },
        "pattern": { "$ref": "#/$defs/nonEmpty" },
        "line": { "type": "integer", "minimum": 1 },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "classification": { "enum": ["archive", "tombstone"] },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "evidence": { "$ref": "#/$defs/evidenceArray" }
      }
    },
    "zeroResidue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "matches", "evidence"],
            "properties": {
              "category": { "enum": ["source", "declarations", "manifests-exports", "packed-artifacts", "consumers", "documentation"] },
              "matches": { "const": 0 },
              "evidence": { "$ref": "#/$defs/evidenceArray" }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "owner_wave",
        "origin",
        "surface",
        "file_effects",
        "intrinsic_job",
        "judgment",
        "replacement",
        "casualty_scan",
        "tombstone",
        "zero_residue",
        "decision_hash"
      ],
      "properties": {
        "decision_id": { "$ref": "#/$defs/decisionId" },
        "owner_wave": { "$ref": "#/$defs/waveId" },
        "origin": { "$ref": "#/$defs/origin" },
        "surface": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["export", "route", "schema", "auth", "module", "facility" ] },
            "name": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "file_effects": { "$ref": "#/$defs/fileEffects" },
        "intrinsic_job": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "evidence"],
          "properties": {
            "claim": { "$ref": "#/$defs/nonEmpty" },
            "evidence": { "$ref": "#/$defs/evidenceArray" }
          }
        },
        "judgment": { "enum": ["replaced", "retired"] },
        "replacement": { "$ref": "#/$defs/replacement" },
        "casualty_scan": { "$ref": "#/$defs/casualtyScan" },
        "tombstone": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "evidence"],
          "properties": {
            "name": { "$ref": "#/$defs/nonEmpty" },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        "zero_residue": { "$ref": "#/$defs/zeroResidue" },
        "decision_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
