{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/vnext-keyframes-public-package-validation-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "snapshot", "manifest", "source_transpose_validation", "target_manifest_sha256", "package", "tarball_sha512", "archive_files", "surface_rows", "runtime_graph_hash", "type_graph_hash", "install", "semantic_hash", "receipt_hash"],
  "properties": {
    "schema": { "const": "vnext-keyframes-public-package-validation/1" },
    "snapshot": { "$ref": "#/$defs/snapshotBinding" },
    "manifest": { "$ref": "#/$defs/manifestBinding" },
    "source_transpose_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["return_hash", "ledger_manifest_hash", "semantic_hash", "receipt_hash", "owner_authorization", "historical_certificate"],
      "properties": {
        "return_hash": { "$ref": "#/$defs/sha256" },
        "ledger_manifest_hash": { "$ref": "#/$defs/sha256" },
        "semantic_hash": { "$ref": "#/$defs/sha256" },
        "receipt_hash": { "$ref": "#/$defs/sha256" },
        "owner_authorization": { "$ref": "#/$defs/ownerAuthorization" },
        "historical_certificate": { "$ref": "#/$defs/historicalCertificate" }
      }
    },
    "target_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "package": { "const": "@mkbabb/keyframes.js@7.0.0" },
    "tarball_sha512": { "$ref": "#/$defs/sha512" },
    "archive_files": { "type": "integer", "minimum": 5 },
    "surface_rows": { "type": "integer", "minimum": 2 },
    "runtime_graph_hash": { "$ref": "#/$defs/sha256" },
    "type_graph_hash": { "$ref": "#/$defs/sha256" },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "installed_files_sha256", "package_lock_sha256", "workspace_links", "runtime", "type"],
      "properties": {
        "install": { "$ref": "#/$defs/processReceipt" },
        "installed_files_sha256": { "$ref": "#/$defs/sha256" },
        "package_lock_sha256": { "$ref": "#/$defs/sha256" },
        "workspace_links": { "const": [] },
        "runtime": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/processReceipt" } },
        "type": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/processReceipt" } }
      }
    },
    "semantic_hash": { "$ref": "#/$defs/sha256" },
    "receipt_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "absolutePath": { "type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "historicalCertificate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "wave_id", "status", "return_hash", "mode", "completion_eligible", "outcome_policy", "proof_semantics", "historical_gate_replay"],
      "properties": {
        "schema": { "const": "vnext-wave-return/2" }, "wave_id": { "const": "K22T" },
        "status": { "const": "COMPLETE" }, "return_hash": { "$ref": "#/$defs/sha256" },
        "mode": { "const": "offline-historical-certificate" }, "completion_eligible": { "const": false },
        "outcome_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["class", "advancing_statuses", "advancing", "reopening"],
          "properties": {
            "class": { "const": "complete" }, "advancing_statuses": { "const": ["COMPLETE"] },
            "advancing": { "const": true }, "reopening": { "const": false }
          }
        },
        "proof_semantics": {
          "type": "object", "additionalProperties": false,
          "required": ["accepted_at_epoch", "holds_now", "authorizes_decision"],
          "properties": { "accepted_at_epoch": { "const": true }, "holds_now": { "const": false }, "authorizes_decision": { "const": false } }
        },
        "historical_gate_replay": {
          "type": "object", "additionalProperties": false,
          "required": ["materialized_pin_count", "executed_gate_count", "epoch_sha256"],
          "properties": {
            "materialized_pin_count": { "type": "integer", "minimum": 1 },
            "executed_gate_count": { "type": "integer", "minimum": 1 },
            "epoch_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "ownerAuthorization": {
      "type": "object", "additionalProperties": false,
      "required": ["nodes", "nodes_sha256"],
      "properties": {
        "nodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/authorityNode" } },
        "nodes_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "authorityNode": {
      "type": "object", "additionalProperties": false,
      "required": ["wave_id", "path", "file_sha256", "return_hash", "wave_contract_sha256", "status"],
      "properties": {
        "wave_id": { "type": "string", "pattern": "^[PVKAGDMC][0-9]{2}[A-Z]?$" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "return_hash": { "$ref": "#/$defs/sha256" },
        "wave_contract_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["COMPLETE", "KEEP", "PRUNE"] }
      }
    },
    "snapshotBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "snapshot_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "snapshot_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "manifest_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "processReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "executable", "args", "exit_code", "signal", "timed_out", "stdout_sha256", "stdout_normalization", "stderr_sha256"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "executable": { "$ref": "#/$defs/absolutePath" },
        "args": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "exit_code": { "const": 0 },
        "signal": { "const": "none" },
        "timed_out": { "const": false },
        "stdout_sha256": { "$ref": "#/$defs/sha256" },
        "stdout_normalization": { "enum": ["none", "npm-elapsed-duration"] },
        "stderr_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
