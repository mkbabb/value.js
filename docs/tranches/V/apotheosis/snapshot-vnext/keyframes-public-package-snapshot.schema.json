{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/vnext-keyframes-public-package-snapshot-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "wave_id", "manifest", "source_transpose_validation", "target_paths", "tarballs", "toolchain", "snapshot_hash"],
  "properties": {
    "schema": { "const": "vnext-keyframes-public-package-snapshot/1" },
    "wave_id": { "const": "K23" },
    "manifest": { "$ref": "#/$defs/embeddedJson" },
    "source_transpose_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["return", "ledger", "receipt", "historical_certificate"],
      "properties": {
        "return": { "$ref": "#/$defs/embeddedJson" },
        "ledger": { "$ref": "#/$defs/embeddedJson" },
        "receipt": { "$ref": "#/$defs/embeddedJson" },
        "historical_certificate": { "$ref": "#/$defs/historicalCertificate" }
      }
    },
    "target_paths": {
      "allOf": [
        { "$ref": "#/$defs/embeddedJson" },
        {
          "properties": {
            "manifest_hash": { "$ref": "#/$defs/sha256" }
          },
          "required": ["manifest_hash"]
        }
      ]
    },
    "tarballs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "dependencies"],
      "properties": {
        "package": { "$ref": "#/$defs/tarball" },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/tarball" },
              {
                "properties": {
                  "name": { "const": "@mkbabb/value.js" },
                  "version": { "const": "5.0.0" }
                },
                "required": ["name", "version"]
              }
            ]
          }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "typescript"],
      "properties": {
        "node": { "$ref": "#/$defs/tool" },
        "npm": { "$ref": "#/$defs/tool" },
        "typescript": { "$ref": "#/$defs/tool" }
      }
    },
    "snapshot_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "absolutePath": { "type": "string", "pattern": "^/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "historicalCertificate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "wave_id", "status", "return_hash", "mode", "completion_eligible", "outcome_policy", "proof_semantics", "historical_gate_replay"],
      "properties": {
        "schema": { "const": "vnext-wave-return/2" },
        "wave_id": { "const": "K22T" },
        "status": { "const": "COMPLETE" },
        "return_hash": { "$ref": "#/$defs/sha256" },
        "mode": { "const": "offline-historical-certificate" },
        "completion_eligible": { "const": false },
        "outcome_policy": {
          "type": "object", "additionalProperties": false,
          "required": ["class", "advancing_statuses", "advancing", "reopening"],
          "properties": {
            "class": { "const": "complete" },
            "advancing_statuses": { "const": ["COMPLETE"] },
            "advancing": { "const": true },
            "reopening": { "const": false }
          }
        },
        "proof_semantics": {
          "type": "object", "additionalProperties": false,
          "required": ["accepted_at_epoch", "holds_now", "authorizes_decision"],
          "properties": {
            "accepted_at_epoch": { "const": true }, "holds_now": { "const": false }, "authorizes_decision": { "const": false }
          }
        },
        "historical_gate_replay": {
          "type": "object", "additionalProperties": false,
          "required": ["materialized_pin_count", "executed_gate_count", "epoch_sha256"],
          "properties": {
            "materialized_pin_count": { "type": "integer", "minimum": 1 },
            "executed_gate_count": { "type": "integer", "minimum": 1 },
            "epoch_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "embeddedJson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "file_sha256", "bytes_base64"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "bytes": { "type": "integer", "minimum": 2 },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_hash": { "$ref": "#/$defs/sha256" },
        "bytes_base64": { "$ref": "#/$defs/base64" }
      }
    },
    "tarball": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "sha512", "integrity", "bytes_base64"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/absolutePath" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sha512": { "$ref": "#/$defs/sha512" },
        "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" },
        "bytes_base64": { "$ref": "#/$defs/base64" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
