{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/vnext-consumer-universe-receipt-2.json",
  "title": "V-next closed, observed consumer-universe receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observed_at",
    "resolved_at",
    "input",
    "resolver_sha256",
    "schema_sha256",
    "receipt_schema_sha256",
    "formation_wave_registry_sha256",
    "discovery_methods",
    "epoch",
    "counts",
    "roots",
    "edges",
    "resolvable",
    "blockers",
    "receipt_hash"
  ],
  "properties": {
    "schema": { "const": "vnext-consumer-universe-receipt/2" },
    "observed_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": "string", "format": "date-time" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "universe_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "universe_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "resolver_sha256": { "$ref": "#/$defs/sha256" },
    "schema_sha256": { "$ref": "#/$defs/sha256" },
    "receipt_schema_sha256": { "$ref": "#/$defs/sha256" },
    "formation_wave_registry_sha256": { "$ref": "#/$defs/sha256" },
    "discovery_methods": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "completed_at",
        "max_age_seconds",
        "bounds_sha256",
        "observed_roots_sha256",
        "observed_edges_sha256",
        "epoch_sha256"
      ],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "max_age_seconds": { "type": "integer", "minimum": 1 },
        "bounds_sha256": { "$ref": "#/$defs/sha256" },
        "observed_roots_sha256": { "$ref": "#/$defs/sha256" },
        "observed_edges_sha256": { "$ref": "#/$defs/sha256" },
        "epoch_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roots", "included_roots", "excluded_roots", "unavailable_roots", "edges", "included_edges", "excluded_edges", "unavailable_edges", "observations"],
      "properties": {
        "roots": { "type": "integer", "minimum": 0 },
        "included_roots": { "type": "integer", "minimum": 0 },
        "excluded_roots": { "type": "integer", "minimum": 0 },
        "unavailable_roots": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "included_edges": { "type": "integer", "minimum": 0 },
        "excluded_edges": { "type": "integer", "minimum": 0 },
        "unavailable_edges": { "type": "integer", "minimum": 0 },
        "observations": { "type": "integer", "minimum": 0 }
      }
    },
    "roots": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolvedRoot" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolvedEdge" }
    },
    "resolvable": { "type": "boolean" },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "receipt_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "absolutePath": { "type": "string", "pattern": "^/", "minLength": 2 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "waveId": { "type": "string", "pattern": "^[PVKAGDMC][0-9]{2}[A-Z]?$" },
    "resolvedRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "canonical_realpath", "branch", "head", "dirty_sha256", "origins", "worktrees", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "repository": { "$ref": "#/$defs/nonEmpty" },
        "canonical_realpath": { "$ref": "#/$defs/absolutePath" },
        "branch": { "$ref": "#/$defs/nonEmpty" },
        "head": { "$ref": "#/$defs/gitHead" },
        "dirty_sha256": { "$ref": "#/$defs/sha256" },
        "origins": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "worktrees": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/absolutePath" } },
        "status": { "enum": ["included", "excluded", "unavailable"] },
        "owner_wave": { "$ref": "#/$defs/waveId" },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "retrigger_wave": { "$ref": "#/$defs/waveId" },
        "condition": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "canonical_realpath", "file_sha256", "locator"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "canonical_realpath": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "locator": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "resolvedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "package", "specifier", "kind", "owner_wave", "status", "observations", "observations_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "source": { "$ref": "#/$defs/nonEmpty" },
        "target": { "$ref": "#/$defs/nonEmpty" },
        "package": { "$ref": "#/$defs/nonEmpty" },
        "specifier": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["runtime", "type", "dynamic", "css", "manifest", "lock", "peer", "transitive"] },
        "owner_wave": { "$ref": "#/$defs/waveId" },
        "status": { "enum": ["included", "excluded", "unavailable"] },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "retrigger_wave": { "$ref": "#/$defs/waveId" },
        "condition": { "$ref": "#/$defs/nonEmpty" },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
        "observations_sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "excluded" } }, "required": ["status"] },
          "then": { "required": ["reason"] }
        },
        {
          "if": { "properties": { "status": { "const": "unavailable" } }, "required": ["status"] },
          "then": { "required": ["reason", "retrigger_wave", "condition"] }
        }
      ]
    }
  }
}
