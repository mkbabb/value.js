{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/vnext-gate-receipt-3.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "wave_id", "gate_id", "kind", "subject", "expected", "wave_contract_sha256", "challenge_sha256", "proof_manifest", "started_at", "finished_at", "result", "execution", "evidence", "receipt_hash"],
  "properties": {
    "schema": { "const": "vnext-gate-receipt/3" },
    "wave_id": { "type": "string", "pattern": "^[PVKAGDMC][0-9]{2}[A-Z]?$" },
    "gate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "kind": { "enum": ["command", "probe", "manual"] },
    "subject": { "type": "string", "minLength": 1 },
    "expected": { "type": "string", "minLength": 1 },
    "wave_contract_sha256": { "$ref": "#/$defs/sha256" },
    "challenge_sha256": { "$ref": "#/$defs/sha256" },
    "proof_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "result": { "enum": ["pass", "fail", "not_run"] },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "command_token", "executable_path", "executable_sha256", "args", "cwd", "pin_repository", "repository_state_sha256", "environment_sha256", "exit_code", "stdout_path", "stdout_sha256", "stderr_path", "stderr_sha256"],
          "properties": {
            "applicability": { "const": "applicable" },
            "command_token": { "type": "string", "pattern": "^[a-zA-Z0-9._+-]+$" },
            "executable_path": { "type": "string", "minLength": 1 },
            "executable_sha256": { "$ref": "#/$defs/sha256" },
            "args": { "type": "array", "items": { "type": "string" } },
            "cwd": { "type": "string", "minLength": 1 },
            "pin_repository": { "type": "string", "minLength": 1 },
            "repository_state_sha256": { "$ref": "#/$defs/sha256" },
            "environment_sha256": { "$ref": "#/$defs/sha256" },
            "exit_code": { "type": "integer", "minimum": 0 },
            "stdout_path": { "type": "string", "minLength": 1 },
            "stdout_sha256": { "$ref": "#/$defs/sha256" },
            "stderr_path": { "type": "string", "minLength": 1 },
            "stderr_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "reason"],
          "properties": {
            "applicability": { "const": "not_applicable" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "description"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "receipt_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "command" }, "result": { "enum": ["pass", "fail"] } } },
      "then": { "properties": { "execution": { "properties": { "applicability": { "const": "applicable" } } } } }
    }
  ]
}
