{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babb.dev/schemas/vnext-value-target-resolutions-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "wave_id", "formation_target", "rows", "manifest_hash"],
  "properties": {
    "schema": { "const": "vnext-value-target-resolutions/1" },
    "wave_id": { "const": "V29T" },
    "formation_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "manifest_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "test", "owner", "outcome", "decision_id", "decision_hash", "return"],
        "properties": {
          "source": { "$ref": "#/$defs/relativePath" },
          "test": { "$ref": "#/$defs/relativePath" },
          "owner": { "$ref": "#/$defs/waveId" },
          "outcome": { "enum": ["KEEP", "PRUNE"] },
          "decision_id": { "$ref": "#/$defs/decisionId" },
          "decision_hash": { "$ref": "#/$defs/sha256" },
          "return": { "$ref": "#/$defs/returnEvidence" }
        }
      }
    },
    "manifest_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "pattern": "^/", "minLength": 2 },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "waveId": { "type": "string", "pattern": "^[PVKAGDMC][0-9]{2}[A-Z]?$" },
    "decisionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "returnEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "return_hash"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "return_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
