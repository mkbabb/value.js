// SERVED MODEL: claude-opus-5-5
//
// color.bbnf — CSS Color 4 (https://www.w3.org/TR/css-color-4/) and the CSS Color 5
// functions `color-mix()` and `light-dark()` (https://www.w3.org/TR/css-color-5/).
// Every numeric component admits a math function (css-color-4 §4, `calc()` in channels).
// Channel scales, clamps and the `none`→missing reading are the semantic layer's
// (`src/css/bbnf/color.ts`); every syntactic rule of the specification is here.

@import "tokens.bbnf" ;
@import "math.bbnf" ;

color = colorMix | lightDark | relativeColor | rgbFn | hslFn | hwbFn | labFn | lchFn
      | oklabFn | oklchFn | colorFn | varFn | hex | colorKeyword ;

// ── components (css-color-4 §4.1) ────────────────────────────────────────────────
component  = mathFn | percentage | number | none ;
hueValue   = mathFn | angle | number | none ;
alphaValue = mathFn | percentage | number | none ;
alphaTail  = ( slash >> alphaValue ) ? ;

// ── rgb() / rgba() — §5.1 modern, and <legacy-rgb-syntax> ──────────────────────
// The legacy comma forms admit neither `none` nor a mix of numbers and percentages
// (KFA-14; css-color-4's changelog: "Made explicit that legacy forms do not support none").
rgbFn        = /rgba?\(\s*/i >> ( rgbModern | rgbLegacyPct | rgbLegacyNum ) << close ;
rgbModern    = component , sp >> component , sp >> component , alphaTail ;
rgbLegacyPct = legacyPct , comma >> legacyPct , comma >> legacyPct , legacyAlpha ;
rgbLegacyNum = legacyNum , comma >> legacyNum , comma >> legacyNum , legacyAlpha ;
legacyPct    = mathFn | percentage ;
legacyNum    = mathFn | number ;
legacyHue    = mathFn | angle | number ;
legacyAlpha  = ( comma >> ( mathFn | percentage | number ) ) ? ;

// ── hsl() / hsla() — §7, and <legacy-hsl-syntax> ────────────────────────────────
hslFn     = /hsla?\(\s*/i >> ( hslModern | hslLegacy ) << close ;
hslModern = hueValue , sp >> component , sp >> component , alphaTail ;
hslLegacy = legacyHue , comma >> legacyPct , comma >> legacyPct , legacyAlpha ;

// ── hwb() §8 · lab()/lch() §9.1–9.2 · oklab()/oklch() §9.3–9.4 — modern only ─────
hwbFn   = /hwb\(\s*/i >> hueValue , sp >> component , sp >> component , alphaTail << close ;
labFn   = /lab\(\s*/i >> component , sp >> component , sp >> component , alphaTail << close ;
lchFn   = /lch\(\s*/i >> component , sp >> component , sp >> hueValue , alphaTail << close ;
oklabFn = /oklab\(\s*/i >> component , sp >> component , sp >> component , alphaTail << close ;
oklchFn = /oklch\(\s*/i >> component , sp >> component , sp >> hueValue , alphaTail << close ;

// ── color() — §10, the predefined spaces (display-p3-linear included) ─────────────
colorFn    = /color\(\s*/i >> colorSpace , sp1 >> component , sp >> component , sp >> component , alphaTail << close ;
colorSpace = /(?:srgb-linear|srgb|display-p3-linear|display-p3|a98-rgb|prophoto-rgb|rec2020|xyz-d50|xyz-d65|xyz)(?![\w-])/i ;

// ── relative colour — css-color-5 §4: `<fn>(from <color> …)` ───────────────────────
// Parsed whole; its value depends on the origin colour's resolution, so the semantic
// layer answers `color_context_required` (the contract value.js carries for it).
relativeColor = relativeHead , sp1 >> color , relativeTail << close ;
relativeHead  = /(?:rgba?|hsla?|hwb|lab|lch|oklab|oklch)\(\s*from(?![\w-])/i
              | /color\(\s*from(?![\w-])/i ;
relativeTail  = ( sp1 >> colorSpace ) ? , sp1 >> relativeComp , sp >> relativeComp , sp >> relativeComp ,
                ( slash >> relativeComp ) ? ;
relativeComp  = mathFn | percentage | angle | number | none | calcKeyword ;

// ── color-mix() — css-color-5 §3 ────────────────────────────────────────────────
// color-mix() = color-mix( <color-interpolation-method>? , [ <color> && <percentage [0,100]>? ]# )
colorMix     = /color-mix\(\s*/i >> ( mixMethod << comma ) ? , mixItem , ( comma >> mixItem ) * << close ;
// The method keeps its keywords as authored (`in`, the space, the hue method's two words) for a value
// list's `color-mix()` call (`value.bbnf` `mixCall`; X.P.W8 `.t`).
mixMethod    = /in(?![\w-])/i , sp1 >> ( mixPolar | mixRect ) ;
mixPolar     = polarSpace , ( sp1 >> hueMethod ) ? ;
mixRect      = rectSpace ;
polarSpace   = /(?:hsl|hwb|lch|oklch)(?![\w-])/i ;
rectSpace    = /(?:srgb-linear|srgb|display-p3-linear|display-p3|a98-rgb|prophoto-rgb|rec2020|lab|oklab|xyz-d50|xyz-d65|xyz)(?![\w-])/i ;
hueMethod    = /(?:shorter|longer|increasing|decreasing)\s+hue(?![\w-])/i ;
mixItem      = mixLead | mixTrail ;
mixLead      = mixPercent , sp >> color ;
mixTrail     = color , ( sp >> mixPercent ) ? ;
mixPercent   = mathFn | percentage ;

// ── light-dark() — css-color-5 §2 ───────────────────────────────────────────────
lightDark = /light-dark\(\s*/i >> color , comma >> color << close ;

// ── hex (§5.2) and the keyword colours (§6: named, transparent, currentcolor, system)
hex          = /#(?:[0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})(?![\w-])/ ;
colorKeyword = /[a-zA-Z][\w-]*(?![\w(-])/ ;
